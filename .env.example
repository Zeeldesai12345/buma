# === Postgres Credentials ===
# Used by the db service and the DATABASE_URL below
POSTGRES_USER=buma
POSTGRES_PASSWORD=buma
POSTGRES_DB=buma

# === Connection Strings ===
# Database: uses Docker service name "db"
DATABASE_URL=postgresql+psycopg://buma:buma@db:5432/buma

# Redis: uses Docker service name "redis"
REDIS_URL=redis://redis:6379/0

# === GitHub Webhook & App ===
# From your GitHub App settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# === GitHub OAuth (Dashboard Login) ===
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# === Security & CORS ===
# Session cookie signing — use a strong random value!
SESSION_SECRET=dev-secret-change-in-production!

# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Claude API (Hybrid Triage Fallback) ===
# Used only by the worker, and only when rule-based classification confidence is below
# CLAUDE_CONFIDENCE_THRESHOLD. Leave ANTHROPIC_API_KEY blank to keep triage 100% rule-based.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_CONFIDENCE_THRESHOLD=0.5
CLAUDE_TIMEOUT_SECONDS=8.0
CLAUDE_MAX_RETRIES=2

# === Claude guardrails (prompt-injection + cost limits) ===
# Issue bodies longer than this are truncated before being sent to Claude.
CLAUDE_MAX_BODY_CHARS=4000
# Max Claude calls per repo per UTC day (Redis counter); over budget the rule result is used.
CLAUDE_DAILY_CALL_LIMIT_PER_REPO=200
# Consecutive Claude failures that open the circuit breaker, and how long it stays open.
CLAUDE_BREAKER_THRESHOLD=5
CLAUDE_BREAKER_COOLDOWN_SECONDS=300
# Most severe priority a Claude-only answer may set (P0 disables the cap).
CLAUDE_MAX_PRIORITY=P1

# === Semantic duplicate detection (T3) — worker only ===
# Every opened issue in an enrolled repo is embedded locally (CPU, no API cost) and stored in
# Postgres (pgvector). Requires the pgvector/pgvector:pg16 image from docker-compose.yml.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MAX_CHARS=2000
# Model cache location. The Docker image already sets this to /opt/fastembed_cache (model baked in);
# only uncomment for host-mode runs. Do NOT set it to an empty value.
# EMBEDDING_CACHE_DIR=.fastembed_cache
DUPLICATE_TOP_K=5
# PROVISIONAL threshold — to be chosen from a labelled precision/recall eval.
DUPLICATE_SIMILARITY_THRESHOLD=0.9
# Keep false until the threshold eval is done: embeddings are stored and searched, but no
# "possible duplicate" line is added to the GitHub comment.
DUPLICATE_COMMENT_ENABLED=false

# === MCP server (read-only, stdio) ===
# Database URL the MCP server uses when a client (e.g. Claude Code) launches it on your machine.
# The Docker db is reachable from the host on port 5433; DATABASE_URL above only works inside Docker.
# BUMA_MCP_DATABASE_URL=postgresql+psycopg://buma:buma@localhost:5433/buma
